.risk-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
}
.risk-modal__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}
.risk-modal__panel {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.risk-modal__icon {
  text-align: center;
  font-size: 56rpx;
  color: #fa8c16;
}
.risk-modal__title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 12rpx;
  color: #333;
}
.risk-modal__body {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 24rpx;
}
.risk-modal__words {
  color: #ff4d4f;
}
.risk-modal__tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}
.risk-modal__actions {
  display: flex;
  margin-top: 32rpx;
}
.risk-modal__btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.risk-modal__btn--edit {
  background: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}
.risk-modal__btn--continue {
  background: #fa8c16;
  color: #fff;
}
