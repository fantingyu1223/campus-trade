.report-form__target {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.report-form__target-type {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4080ff;
  background: #f0f7ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 16rpx;
}
.report-form__target-title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.report-form__card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.report-form__label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.report-form__required {
  color: #ff4d4f;
}
.report-form__hint {
  font-size: 24rpx;
  color: #999;
}
.report-form__picker-value {
  font-size: 28rpx;
  color: #333;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}
.report-form__picker-value--placeholder {
  color: #999;
}
.report-form__textarea {
  width: 100%;
  height: 220rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}
.report-form__counter {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.report-form__images {
  display: flex;
  flex-wrap: wrap;
}
.report-form__image-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 16rpx 16rpx 0;
}
.report-form__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.report-form__image-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 26rpx;
}
.report-form__image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  color: #ccc;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.report-form__footer {
  padding: 24rpx;
}
.report-form__submit {
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.report-form__submit--disabled {
  opacity: 0.6;
}
