/* 身份标 · 设计规范「橙市」：个人退到中性灰，认证商家校蓝亮标（F33-AC1） */
.identity-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 个人身份：学生/教职工 */
.identity-badge--person {
  color: var(--ct-ink-600);
  background: var(--ct-neutral-100);
}

/* 认证商家：校蓝撞色，与个人闲置可区分（F33-AC1） */
.identity-badge--merchant {
  color: var(--ct-accent-strong);
  background: var(--ct-accent-soft);
  font-weight: 700;
}
