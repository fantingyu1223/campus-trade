.wb-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.wb-card--done {
  opacity: 0.55;
}
.wb-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.wb-card__category {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ef;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.wb-card__countdown {
  font-size: 22rpx;
  color: #999;
}
.wb-card__countdown--urgent {
  color: #ff4d4f;
  font-weight: 600;
}
.wb-card__status {
  font-size: 22rpx;
  color: #999;
}
.wb-card__title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.wb-card__meta {
  display: flex;
  align-items: center;
}
.wb-card__price {
  font-size: 28rpx;
  color: #fa541c;
  font-weight: 600;
  margin-right: 20rpx;
}
.wb-card__condition {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.wb-card__ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.wb-card__op {
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #d9d9d9;
  border-radius: 32rpx;
  padding: 10rpx 30rpx;
  margin-left: 20rpx;
}
.wb-card__op--primary {
  color: #07c160;
  border-color: #07c160;
}
