<view class="product-card" bindtap="onTap" data-id="{{product.id}}">
  <view class="product-card__cover">
    <image wx:if="{{product.cover}}" src="{{product.cover}}" mode="aspectFill" class="product-card__img" />
    <view wx:else class="product-card__img product-card__img--placeholder">实拍图</view>
    <view wx:if="{{product.is_urgent}}" class="product-card__urgent">急出</view>
    <view wx:if="{{showSold && product.status === 'sold'}}" class="product-card__sold">已售</view>
  </view>
  <view class="product-card__body">
    <view class="product-card__title">{{product.title}}</view>
    <view class="product-card__meta">
      <text class="product-card__price">¥{{product.price}}</text>
      <text class="product-card__condition">{{product.condition_label}}</text>
    </view>
    <view class="product-card__seller">
      <text class="product-card__nickname">{{product.seller_nickname || '卖家'}}</text>
      <identity-badge identity-type="{{product.seller_role}}" />
    </view>
  </view>
</view>
