.product-card {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.product-card__cover {
  position: relative;
  width: 100%;
  height: 320rpx;
}
.product-card__img {
  width: 100%;
  height: 100%;
  display: block;
}
.product-card__img--placeholder {
  background: #e8e8e8;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
.product-card__urgent {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.product-card__sold {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.product-card__body {
  padding: 16rpx 20rpx;
}
.product-card__title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-card__meta {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.product-card__price {
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: 600;
}
.product-card__condition {
  color: #999;
  font-size: 22rpx;
  margin-left: 16rpx;
}
.product-card__seller {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.product-card__nickname {
  color: #666;
  font-size: 22rpx;
  margin-right: 12rpx;
}
