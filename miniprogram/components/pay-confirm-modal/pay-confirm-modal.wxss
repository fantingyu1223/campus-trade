.pay-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
}
.pay-modal__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}
.pay-modal__panel {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}
.pay-modal__title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: #333;
}
.pay-modal__warning {
  margin-top: 24rpx;
  background: #fff1f0;
  color: #cf1322;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
}
.pay-modal__rules {
  margin-top: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}
.pay-modal__rule {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}
.pay-modal__agree {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
}
.pay-modal__checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pay-modal__checkbox--on {
  background: #07c160;
  border-color: #07c160;
}
.pay-modal__agree-text {
  font-size: 26rpx;
  color: #333;
}
.pay-modal__btn {
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-top: 24rpx;
}
.pay-modal__btn--confirm {
  background: #07c160;
  color: #fff;
}
.pay-modal__btn--disabled {
  background: #b7ebcc;
  color: rgba(255, 255, 255, 0.9);
}
.pay-modal__btn--cancel {
  background: #f5f5f5;
  color: #666;
  margin-top: 16rpx;
}
