.intent-card {
  width: 420rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.intent-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.intent-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.intent-card__status {
  font-size: 22rpx;
  color: #999;
}
.intent-card__status--pending {
  color: #fa8c16;
}
.intent-card__status--confirmed {
  color: #07c160;
}
.intent-card__status--rejected {
  color: #ff4d4f;
}
.intent-card__row {
  display: flex;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.intent-card__label {
  color: #999;
  width: 130rpx;
}
.intent-card__price {
  color: #ff4d4f;
  font-weight: 600;
}
.intent-card__value {
  color: #333;
  flex: 1;
}
.intent-card__actions {
  display: flex;
  margin-top: 24rpx;
}
.intent-card__btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.intent-card__btn--reject {
  background: #f5f5f5;
  color: #666;
  margin-right: 20rpx;
}
.intent-card__btn--accept {
  background: #07c160;
  color: #fff;
}
