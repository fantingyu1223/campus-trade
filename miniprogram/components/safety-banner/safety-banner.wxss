.safety-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fdf6ec;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.safety-banner__icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.safety-banner__text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #e6a23c;
  flex: 1;
}
