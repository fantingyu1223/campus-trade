.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20rpx;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 0;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.gallery {
  width: 100%;
  height: 560rpx;
  background: #fff;
}
.gallery__img {
  width: 100%;
  height: 100%;
}
.gallery--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 32rpx;
  background: #eee;
}
.info {
  background: #fff;
  padding: 24rpx;
}
.info__price-row {
  display: flex;
  align-items: baseline;
}
.info__price {
  color: #ff4d4f;
  font-size: 44rpx;
  font-weight: 600;
}
.info__original {
  color: #999;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.info__urgent {
  background: #fff1f0;
  color: #ff4d4f;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}
.info__title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-top: 16rpx;
}
.info__meta {
  margin-top: 16rpx;
}
.info__tag {
  background: #f5f5f5;
  color: #666;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
}
.info__row {
  display: flex;
  margin-top: 20rpx;
  font-size: 26rpx;
}
.info__label {
  color: #999;
  width: 140rpx;
}
.info__value {
  color: #333;
  flex: 1;
}
.section {
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx;
}
.section__title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.section__body {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
.seller {
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}
.seller__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f7ee;
  color: #07c160;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.seller__info {
  flex: 1;
  display: flex;
  align-items: center;
}
.seller__nickname {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}
.seller__credit {
  color: #999;
  font-size: 22rpx;
}
.safety-tip {
  margin: 16rpx 20rpx 0;
  background: #fffbe6;
  color: #ad6800;
  font-size: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  line-height: 1.6;
}
.report {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 32rpx 0 16rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.footer__btn {
  text-align: center;
  padding: 22rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.footer__btn--primary {
  background: #07c160;
  color: #fff;
}
.footer__placeholder {
  height: 140rpx;
}
.sold-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.sold-mask__text {
  color: #fff;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}
.sold-mask__sub {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  margin-top: 24rpx;
}
