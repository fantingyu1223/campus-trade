/* 详情页 · 设计规范「橙市」：底部操作条 / 价格区 / 急出标套用 token */
.page {
  min-height: 100vh;
  background: var(--ct-bg);
  padding-bottom: 20rpx;
}
.state {
  text-align: center;
  color: var(--ct-ink-400);
  font-size: 26rpx;
  padding: 160rpx 0;
}
.state--error {
  color: var(--ct-urgent);
}
.state__retry {
  color: var(--ct-accent);
  margin-top: 20rpx;
}
.gallery {
  width: 100%;
  height: 560rpx;
  background: var(--ct-card);
}
.gallery__img {
  width: 100%;
  height: 100%;
}
.gallery--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ct-primary-strong);
  font-size: 32rpx;
  background: var(--ct-primary-soft);
}
.info {
  background: var(--ct-card);
  padding: 24rpx;
}
.info__price-row {
  display: flex;
  align-items: center;
}
/* 价格：小字主橙 44rpx/700 tabular-nums */
.info__price {
  color: var(--ct-primary-strong);
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.info__original {
  color: var(--ct-ink-400);
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 16rpx;
}
/* 急出：品红实心 pill */
.info__urgent {
  background: var(--ct-urgent);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999px;
  box-shadow: var(--ct-shadow-urgent);
  margin-left: 16rpx;
}
.info__title {
  font-size: 32rpx;
  color: var(--ct-ink-900);
  font-weight: 700;
  margin-top: 16rpx;
}
.info__meta {
  margin-top: 16rpx;
}
/* 属性 tag：橙浅底 chip */
.info__tag {
  background: var(--ct-primary-soft);
  color: var(--ct-primary-strong);
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 999px;
  margin-right: 16rpx;
}
.info__row {
  display: flex;
  margin-top: 20rpx;
  font-size: 26rpx;
}
.info__label {
  color: var(--ct-ink-400);
  width: 140rpx;
}
.info__value {
  color: var(--ct-ink-900);
  flex: 1;
}
.section {
  background: var(--ct-card);
  margin-top: 16rpx;
  padding: 24rpx;
}
.section__title {
  font-size: 28rpx;
  color: var(--ct-ink-900);
  font-weight: 700;
  margin-bottom: 16rpx;
}
.section__body {
  font-size: 26rpx;
  color: var(--ct-ink-600);
  line-height: 1.6;
}
.seller {
  background: var(--ct-card);
  margin-top: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}
/* 卖家头像占位：橙浅底 + 主橙字 */
.seller__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ct-primary-soft);
  color: var(--ct-primary-strong);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.seller__info {
  flex: 1;
  display: flex;
  align-items: center;
}
.seller__nickname {
  font-size: 28rpx;
  color: var(--ct-ink-900);
  font-weight: 500;
  margin-right: 16rpx;
}
.seller__credit {
  color: var(--ct-ink-400);
  font-size: 22rpx;
}
/* 安全提示：便签黄 + 虚线描边（与 safety-banner 组件同语言） */
.safety-tip {
  margin: 16rpx 20rpx 0;
  background: var(--ct-warn-bg);
  border: 2rpx dashed var(--ct-warn-line);
  color: var(--ct-warn-text);
  font-size: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--ct-radius-banner);
  line-height: 1.6;
}
.report {
  text-align: center;
  color: var(--ct-ink-400);
  font-size: 24rpx;
  padding: 32rpx 0 16rpx;
}
/* 底部操作条：橙渐变主按钮 + FAB 级投影 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--ct-card);
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(178, 88, 42, 0.08);
}
.footer__btn {
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 700;
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}
.footer__btn--primary {
  background: linear-gradient(135deg, var(--ct-primary-light), var(--ct-primary));
  color: #fff;
  box-shadow: var(--ct-shadow-fab);
}
.footer__placeholder {
  height: 140rpx;
}
.sold-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(43, 29, 22, 0.65);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.sold-mask__text {
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.sold-mask__sub {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  margin-top: 24rpx;
}
