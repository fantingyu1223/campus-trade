.page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}
.safety-bar {
  background: #fffbe6;
  color: #ad6800;
  font-size: 22rpx;
  padding: 14rpx 24rpx;
  line-height: 1.5;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 0;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.msg-scroll {
  height: calc(100vh - 220rpx);
  padding: 0 24rpx;
  box-sizing: border-box;
}
.load-earlier {
  text-align: center;
  color: #07c160;
  font-size: 24rpx;
  padding: 24rpx 0;
}
.load-earlier--loading {
  color: #999;
}
.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 24rpx;
}
.msg-row--self {
  flex-direction: row-reverse;
}
.msg-bubble {
  max-width: 460rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}
.msg-bubble--self {
  background: #95ec69;
}
.msg-read {
  font-size: 20rpx;
  color: #fa8c16;
  margin: 0 12rpx;
  flex-shrink: 0;
}
.msg-read--read {
  color: #999;
}
.msg-intent {
  max-width: 480rpx;
}
.msg-image {
  max-width: 320rpx;
  border-radius: 12rpx;
}
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.input-bar__input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}
.input-bar__send {
  margin-left: 20rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 14rpx 36rpx;
  border-radius: 36rpx;
}
.input-bar__send--disabled {
  background: #b7ebcc;
}
.input-bar__placeholder {
  height: 130rpx;
}
