/* 资料编辑页 · 设计规范「橙市」：区块卡片 / 头像 grid / 表单控件套用 token */

.section {
  background: var(--ct-card);
  border-radius: var(--ct-radius-card);
  box-shadow: var(--ct-shadow-card);
  margin: 24rpx;
  padding: 28rpx;
}

.section__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ct-ink-900);
  margin-bottom: 20rpx;
}

.avatar-current {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-current__img,
.avatar-current__placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-current__placeholder {
  background: var(--ct-neutral-100);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.avatar-current__tip {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--ct-ink-400);
}

.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.avatar-grid__item {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
}

.avatar-grid__item--active {
  border-color: var(--ct-primary);
}

.avatar-grid__item--custom {
  background: var(--ct-neutral-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-grid__item--uploading {
  opacity: 0.6;
}

.avatar-grid__plus {
  font-size: 48rpx;
  color: var(--ct-ink-400);
}

.avatar-custom-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ct-primary-strong);
}

.avatar-grid__img {
  width: 100%;
  height: 100%;
}

.field-input {
  background: var(--ct-neutral-100);
  border-radius: var(--ct-radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ct-ink-900);
}

.field-textarea {
  background: var(--ct-neutral-100);
  border-radius: var(--ct-radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ct-ink-900);
  width: auto;
  min-height: 160rpx;
}

.anon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anon-row__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ct-ink-900);
}

.anon-row__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ct-ink-600);
}

.save-btn {
  margin: 40rpx 24rpx;
}
