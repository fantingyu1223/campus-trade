.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}
.notice {
  background: #fffbe8;
  color: #b8860b;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
}
.form {
  background: #fff;
  margin-top: 16rpx;
  padding: 0 24rpx;
}
.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field__label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.field__required {
  color: #ff4d4f;
}
.field__input {
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}
.field__picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  color: #333;
}
.field__picker--placeholder {
  color: #999;
}
.field__picker-arrow {
  color: #ccc;
}
.field__error {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-top: 12rpx;
}
.price-range {
  display: flex;
  align-items: center;
}
.price-range__input {
  flex: 1;
}
.price-range__sep {
  margin: 0 16rpx;
  color: #999;
}
.field__textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.footer__submit {
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}
.footer__submit--disabled {
  opacity: 0.6;
}
