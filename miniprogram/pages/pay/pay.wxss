.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 0;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}
.summary-card__cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}
.summary-card__cover--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 22rpx;
}
.summary-card__info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.summary-card__title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.summary-card__seller {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}
.summary-card__amount {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: 600;
  margin-top: 12rpx;
}
.pay-tip {
  background: #fffbe6;
  color: #ad6800;
  font-size: 22rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-top: 24rpx;
  line-height: 1.5;
}
.pay-btn {
  margin-top: 48rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 44rpx;
}
.pay-btn--disabled {
  background: #b7ebcc;
}
