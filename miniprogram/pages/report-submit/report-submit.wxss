.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 匿名保护提示卡（F18-AC2） */
.anon-notice {
  background: #e8f4ff;
  color: #1a6fb5;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 20rpx 24rpx;
  margin: 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #b3d8ff;
}

/* 回执页 */
.result {
  background: #fff;
  margin: 32rpx 24rpx;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
}
.result__icon {
  text-align: center;
  font-size: 72rpx;
}
.result__title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-top: 16rpx;
}
.result__row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-top: 24rpx;
}
.result__label {
  color: #999;
}
.result__value {
  color: #333;
}
.result__value--status {
  color: #07c160;
  font-weight: 600;
}
.result__desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-top: 24rpx;
}
.result__btn {
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  margin-top: 32rpx;
}
