.page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.tabs {
  display: flex;
}
.tabs__item {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  margin-right: 12rpx;
}
.tabs__item--active {
  color: #07c160;
  background: #e8f8ef;
  font-weight: 600;
}
.topbar__publish {
  font-size: 26rpx;
  color: #fff;
  background: #07c160;
  border-radius: 32rpx;
  padding: 10rpx 26rpx;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 40rpx;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.list {
  height: calc(100vh - 96rpx);
  padding: 24rpx;
  box-sizing: border-box;
}
.list__safe {
  height: 40rpx;
}
