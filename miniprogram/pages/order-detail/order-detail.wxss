.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 0;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.steps {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
}
.step {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  position: relative;
}
.step--active {
  color: #07c160;
  font-weight: 600;
  font-size: 26rpx;
}
.countdown {
  margin-top: 24rpx;
  background: #fff7e6;
  color: #d48806;
  font-size: 26rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  text-align: center;
}
.countdown--expired {
  background: #fff1f0;
  color: #cf1322;
}
.info-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}
.info-card__row {
  display: flex;
  font-size: 26rpx;
  color: #333;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-card__row:last-child {
  border-bottom: none;
}
.info-card__label {
  width: 140rpx;
  color: #999;
  flex-shrink: 0;
}
.info-card__amount {
  color: #ff4d4f;
  font-weight: 600;
}
.actions {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.btn {
  flex: 1;
  min-width: 200rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 40rpx;
  background: #fff;
  color: #333;
  border: 1rpx solid #ddd;
  box-sizing: border-box;
}
.btn--primary {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}
.btn--danger {
  color: #ff4d4f;
  border-color: #ff4d4f;
}
.btn--plain {
  color: #999;
}
.timeline {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.timeline__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.timeline__item {
  display: flex;
  padding: 12rpx 0;
}
.timeline__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07c160;
  margin-top: 12rpx;
  flex-shrink: 0;
}
.timeline__content {
  margin-left: 20rpx;
  min-width: 0;
}
.timeline__time {
  font-size: 22rpx;
  color: #999;
}
.timeline__event {
  font-size: 26rpx;
  color: #333;
  margin-top: 4rpx;
}
