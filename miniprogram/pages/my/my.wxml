<view class="page">
  <!-- 已注销终态 -->
  <view wx:if="{{cancelled}}" class="cancelled">
    <view class="cancelled__icon">👋</view>
    <view class="cancelled__title">已注销，感谢使用</view>
    <view class="cancelled__desc">账号注销申请已提交，{{effectiveAt}}</view>
    <button class="cancelled__btn" bindtap="onGotoLogin">返回登录页</button>
  </view>

  <block wx:else>
    <!-- 未登录态：登录入口 -->
    <view wx:if="{{!loggedIn}}" class="guest">
      <view class="guest__icon">👤</view>
      <view class="guest__desc">登录后可发布闲置、发起会话与交易</view>
      <button class="guest__btn" bindtap="onGotoLogin">微信登录 / 注册</button>
    </view>

    <block wx:else>
    <!-- 用户信息卡 -->
    <view class="user-card">
      <view class="user-card__avatar">
        <image wx:if="{{user.avatar}}" class="user-card__avatar-img" src="{{user.avatar}}" mode="aspectFill" />
        <text wx:else class="user-card__avatar-placeholder">👤</text>
      </view>
      <view class="user-card__info">
        <view class="user-card__name-row">
          <text class="user-card__nickname">{{user.nickname}}</text>
          <identity-badge identity-type="{{user.identity_type}}" />
        </view>
        <!-- 认证商家强化标识（F33-AC1） -->
        <view wx:if="{{isMerchant}}" class="user-card__merchant">
          <merchant-badge size="large" />
        </view>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="group">
      <view class="cell" hover-class="ct-press" data-url="/pages/my-products/my-products" bindtap="onNav">
        <text class="cell__label">📦 我的商品</text>
        <text class="cell__arrow">›</text>
      </view>
      <view class="cell" hover-class="ct-press" data-url="/pages/want-buy/want-buy" bindtap="onNav">
        <text class="cell__label">🛒 我的求购</text>
        <text class="cell__arrow">›</text>
      </view>
      <view class="cell" hover-class="ct-press" data-url="/pages/favorites/favorites" bindtap="onNav">
        <text class="cell__label">⭐ 我的收藏</text>
        <text class="cell__arrow">›</text>
      </view>
      <view class="cell" hover-class="ct-press" data-url="/pages/order-list/order-list" bindtap="onNav">
        <text class="cell__label">📋 我的订单</text>
        <text class="cell__arrow">›</text>
      </view>
    </view>

    <!-- 账号与安全 -->
    <view class="group">
      <view class="group__title">账号与安全</view>
      <view class="cell cell--danger" hover-class="ct-press" bindtap="onCancelAccountTap">
        <text class="cell__label cell__label--danger">注销账号</text>
        <text class="cell__arrow">›</text>
      </view>
    </view>
    </block>
  </block>

  <!-- 注销二次确认弹窗（F26-AC1） -->
  <cancel-account-modal
    visible="{{modalVisible}}"
    confirming="{{confirming}}"
    bind:confirm="onModalConfirm"
    bind:cancel="onModalCancel"
  />
</view>
