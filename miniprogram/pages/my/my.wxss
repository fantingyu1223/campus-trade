/* 我的页 · 设计规范「橙市」：用户卡 / cell 列表套用 token */
.page {
  min-height: 100vh;
  background: var(--ct-bg);
  padding-bottom: 32rpx;
}

/* 用户信息卡 */
.user-card {
  display: flex;
  align-items: center;
  background: var(--ct-card);
  border-radius: var(--ct-radius-card);
  box-shadow: var(--ct-shadow-card);
  padding: 32rpx 24rpx;
  margin: 24rpx 24rpx 16rpx;
}
.user-card__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--ct-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.user-card__avatar-img {
  width: 120rpx;
  height: 120rpx;
}
.user-card__avatar-placeholder {
  font-size: 56rpx;
  color: var(--ct-primary-strong);
}
.user-card__info {
  margin-left: 24rpx;
  flex: 1;
}
.user-card__name-row {
  display: flex;
  align-items: center;
}
.user-card__nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ct-ink-900);
  margin-right: 16rpx;
}
.user-card__merchant {
  margin-top: 12rpx;
}
.user-card__bio {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ct-ink-600);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.user-card__anon-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ct-ink-400);
}

/* 分组与功能项 */
.group {
  background: var(--ct-card);
  border-radius: var(--ct-radius-card);
  box-shadow: var(--ct-shadow-card);
  margin: 0 24rpx 16rpx;
  overflow: hidden;
}
.group__title {
  font-size: 24rpx;
  color: var(--ct-ink-400);
  padding: 20rpx 24rpx 0;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--ct-neutral-100);
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}
.cell:last-child {
  border-bottom: none;
}
.cell__label {
  font-size: 28rpx;
  color: var(--ct-ink-900);
}
.cell__label--danger {
  color: var(--ct-urgent);
}
.cell__arrow {
  color: var(--ct-ink-400);
  font-size: 32rpx;
}

/* 已注销终态 */
.cancelled {
  background: var(--ct-card);
  border-radius: var(--ct-radius-card);
  box-shadow: var(--ct-shadow-card);
  margin: 32rpx 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
}
.cancelled__icon {
  font-size: 72rpx;
}
.cancelled__title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ct-ink-900);
  margin-top: 16rpx;
}
.cancelled__desc {
  font-size: 24rpx;
  color: var(--ct-ink-400);
  margin-top: 16rpx;
}
.cancelled__btn {
  background: linear-gradient(135deg, var(--ct-primary-light), var(--ct-primary));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999px;
  margin-top: 40rpx;
}

/* 未登录引导态 */
.guest {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.guest__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.guest__desc {
  font-size: 26rpx;
  color: var(--ct-ink-600);
  margin-bottom: 40rpx;
}

.guest__btn {
  background: linear-gradient(135deg, var(--ct-primary-light), var(--ct-primary));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999px;
  box-shadow: var(--ct-shadow-fab);
  padding: 0 64rpx;
}

/* 校园认证引导条（橙市 token） */
.verify-banner {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #fff1e8, #ffe4d3);
  border: 1rpx solid #ffc9ad;
  border-radius: 28rpx;
}

.verify-banner__icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.verify-banner__body {
  flex: 1;
}

.verify-banner__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #d93e10;
}

.verify-banner__desc {
  font-size: 24rpx;
  color: #a0694f;
  margin-top: 4rpx;
}

.verify-banner__arrow {
  font-size: 36rpx;
  color: #d93e10;
}

.cell__value {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #a08d80;
  margin-right: 8rpx;
}
