.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}
.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.tabs__item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  border-radius: 8rpx;
}
.tabs__item--active {
  background: #e8f7ee;
  color: #07c160;
  font-weight: 600;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 0;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.state__publish {
  color: #07c160;
  margin-top: 24rpx;
}
.item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.item__actions {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f5f5f5;
}
.item__btn {
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 28rpx;
  padding: 10rpx 32rpx;
  margin-left: 20rpx;
}
.item__btn--primary {
  color: #07c160;
  border-color: #07c160;
}
