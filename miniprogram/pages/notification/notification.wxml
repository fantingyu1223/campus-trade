<view class="page">
  <!-- 顶部：未读数 + 全部已读 -->
  <view class="topbar">
    <view class="topbar__count">{{unreadCount > 0 ? `${unreadCount} 条未读` : '没有未读通知'}}</view>
    <view class="topbar__read-all {{unreadCount === 0 ? 'topbar__read-all--disabled' : ''}}" bindtap="onReadAll">全部已读</view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state state--error">
    <text>{{error}}</text>
    <view class="state__retry" bindtap="onRetry">点击重试</view>
  </view>

  <scroll-view wx:else scroll-y class="list" enhanced>
    <view wx:if="{{list.length === 0}}" class="state">暂无通知</view>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="item {{item.is_read ? 'item--read' : ''}}"
      data-id="{{item.id}}"
      bindtap="onItemTap"
    >
      <view class="item__icon">{{item.icon}}</view>
      <view class="item__body">
        <view class="item__header">
          <text class="item__type">{{item.type_label}}</text>
          <text class="item__time">{{item.relative_time}}</text>
        </view>
        <view class="item__title">{{item.title}}</view>
      </view>
      <view wx:if="{{!item.is_read}}" class="item__dot"></view>
    </view>
    <view class="list__safe"></view>
  </scroll-view>
</view>
