.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}
.steps {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.steps__item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.steps__dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.steps__label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.steps__item--active .steps__dot {
  background: #07c160;
  color: #fff;
}
.steps__item--active .steps__label {
  color: #07c160;
}
.steps__line {
  flex: 1;
  height: 2rpx;
  background: #eee;
  margin: 0 16rpx 32rpx;
}
.steps__line--active {
  background: #07c160;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
}
.card__title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}
.card__tip {
  font-size: 24rpx;
  color: #999;
  margin: 12rpx 0 24rpx;
}
.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img-grid__item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 20rpx 20rpx 0;
}
.img-grid__img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.img-grid__delete {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-grid__add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}
.img-grid__add-icon {
  font-size: 56rpx;
  line-height: 1;
}
.img-grid__add-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}
.field-error {
  color: #ff4d4f;
  font-size: 22rpx;
  margin-top: 10rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-item__label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 14rpx;
}
.form-item__required {
  color: #ff4d4f;
}
.form-item__input {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.form-item__textarea {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: auto;
  min-height: 160rpx;
}
.form-item__picker {
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}
.form-item__picker--placeholder {
  color: #999;
}
.form-item--switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.form-item--switch .form-item__label {
  margin-bottom: 0;
}
.form-item__hint {
  color: #ad6800;
  font-size: 22rpx;
  margin: -12rpx 0 20rpx;
}
.btn-row {
  display: flex;
  margin-top: 12rpx;
}
.btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.btn--primary {
  background: #07c160;
  color: #fff;
  margin-top: 24rpx;
}
.btn-row .btn--primary {
  margin-top: 0;
  margin-left: 20rpx;
}
.btn--ghost {
  background: #f5f5f5;
  color: #666;
}
.btn--disabled {
  opacity: 0.6;
}
.summary__images {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}
.summary__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
}
.summary__row {
  display: flex;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.summary__label {
  color: #999;
  width: 140rpx;
}
.summary__value {
  color: #333;
  flex: 1;
}
.summary__value--price {
  color: #ff4d4f;
  font-weight: 600;
}
.summary__row + .btn-row {
  margin-top: 28rpx;
}
.btn-row {
  margin-top: 28rpx;
}
