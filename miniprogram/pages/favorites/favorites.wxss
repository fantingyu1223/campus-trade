.page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 40rpx;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.list {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.list__tip {
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
  margin-top: 24rpx;
}
.list__safe {
  height: 40rpx;
}
.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.item__cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.item__cover--placeholder {
  background: #f0f0f0;
  color: #ccc;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.item__body {
  flex: 1;
  min-width: 0;
}
.item__title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}
.item__price-row {
  display: flex;
  align-items: baseline;
}
.item__price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin-right: 12rpx;
}
.item__fav-price {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}
.item__trend {
  font-size: 24rpx;
}
.item__trend--down {
  color: #07c160;
}
.item__trend--up {
  color: #ff4d4f;
}
.item__badge {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
