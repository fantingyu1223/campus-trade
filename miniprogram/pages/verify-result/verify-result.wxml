<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="card">
    <view class="card__icon">⏳</view>
    <view class="card__title">状态查询中…</view>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{error}}" class="card">
    <view class="card__icon">⚠️</view>
    <view class="card__title">{{error}}</view>
    <button class="card__btn card__btn--plain" bindtap="fetchStatus">重新查询</button>
  </view>

  <!-- 审核中 -->
  <view wx:elif="{{status === 'pending'}}" class="card">
    <view class="card__icon">🕐</view>
    <view class="card__title">认证审核中</view>
    <view class="card__desc">认证信息已提交，请耐心等待审核结果。审核通过后你将获得发布、会话与交易权限。</view>
    <button class="card__btn card__btn--plain" bindtap="fetchStatus">刷新状态</button>
  </view>

  <!-- 认证通过 -->
  <view wx:elif="{{status === 'approved'}}" class="card">
    <view class="card__icon">✅</view>
    <view class="card__title card__title--success">认证通过</view>
    <view class="card__desc">你已完成身份认证，现在可以发布商品、联系卖家与发起交易了。</view>
    <button class="card__btn" type="primary" bindtap="onGoHome">去逛逛</button>
  </view>

  <!-- 认证驳回 -->
  <view wx:elif="{{status === 'rejected'}}" class="card">
    <view class="card__icon">❌</view>
    <view class="card__title card__title--fail">认证未通过</view>
    <view class="card__desc" wx:if="{{rejectReason}}">原因：{{rejectReason}}</view>
    <view class="card__desc" wx:else>认证信息未通过校验，请核对后重新提交。</view>
    <button class="card__btn" type="primary" bindtap="onRetry">重新认证</button>
  </view>

  <!-- 未提交过认证 -->
  <view wx:else class="card">
    <view class="card__icon">ℹ️</view>
    <view class="card__title">尚未提交认证</view>
    <view class="card__desc">完成身份认证后即可解锁发布与交易功能。</view>
    <button class="card__btn" type="primary" bindtap="onRetry">去认证</button>
  </view>
</view>
