.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}
.state {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 160rpx 0;
}
.state--error {
  color: #ff4d4f;
}
.state__retry {
  color: #07c160;
  margin-top: 20rpx;
}
.order-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.order-item__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-item__time {
  font-size: 22rpx;
  color: #999;
}
.order-item__status {
  font-size: 22rpx;
  border: 1rpx solid;
  border-radius: 20rpx;
  padding: 2rpx 16rpx;
}
.order-item__title {
  font-size: 30rpx;
  color: #333;
  margin-top: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-item__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.order-item__peer {
  font-size: 24rpx;
  color: #999;
}
.order-item__amount {
  font-size: 30rpx;
  color: #ff4d4f;
  font-weight: 600;
}
