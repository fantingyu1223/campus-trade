.page {
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tabs__item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 18rpx 0;
  border-radius: 12rpx;
}

.tabs__item--active {
  background: #07c160;
  color: #fff;
  font-weight: 600;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.state {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 0;
  text-align: center;
}

.state--error {
  color: #f56c6c;
}

.state__retry {
  color: #576b95;
  margin-top: 12rpx;
}

.school-list {
  max-height: 360rpx;
}

.school-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 16rpx;
  border-radius: 12rpx;
}

.school-item--active {
  background: #ecf9f0;
}

.school-item__name {
  font-size: 28rpx;
  color: #333;
}

.school-item__city {
  font-size: 24rpx;
  color: #999;
}

.join-card {
  background: #fdf6ec;
  border: 1rpx solid #e6a23c;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.join-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e6a23c;
  margin-bottom: 12rpx;
}

.join-card__desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.join-card__btn {
  background: #e6a23c;
  color: #fff;
}

.radio-row {
  display: flex;
  margin-bottom: 20rpx;
}

.radio {
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid #ddd;
  margin-right: 20rpx;
}

.radio--active {
  color: #07c160;
  border-color: #07c160;
  background: #ecf9f0;
}

.merchant-tip {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.merchant-tip--sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  margin-bottom: 0;
}

.evidence-list {
  display: flex;
  flex-wrap: wrap;
}

.evidence-list__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.evidence-add {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.submit-btn {
  border-radius: 44rpx;
  font-size: 32rpx;
}
